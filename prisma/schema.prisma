generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String        @id @default(uuid())
  googleId  String?       @unique
  email     String?       @unique
  name      String?
  avatarUrl String?
  username  String?       @unique
  playerTag String?       @unique
  history   GameHistory[]
  sessions  GameSession[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
}

model Room {
  id        String        @id @default(uuid())
  status    String        @default("WAITING") // WAITING, PLAYING, FINISHED
  player1Id String?
  player2Id String?
  winnerId  String?
  createdAt DateTime      @default(now())
  history   GameHistory[]
}

model GameHistory {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  score     Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
}

model GameSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  modo      Int
  pares     Int
  tempo     Int
  pontuacao Int
  erros     Int
  createdAt DateTime @default(now())
}
