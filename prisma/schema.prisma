generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GameSession {
  id        Int      @id @default(autoincrement())
  modo      Int      
  pares     Int
  tempo     Int
  pontuacao Int
  erros     Int
  createdAt DateTime @default(now())
}
