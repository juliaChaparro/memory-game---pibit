# Atualiza .gitignore com exclusões de teste e backups
# ----- Dependências e builds -----
node_modules/               
/dist/                     
/.pnp.js                  
npm-debug.log*              
yarn-debug.log*             
yarn-error.log*             

# ----- Banco de dados / artefatos temporários -----
dev.db                    
/generated/                 
*.sqlite                    

# ----- Configurações de ambiente -----
.env                        
.env.*                      
/*.local                    

# ----- IDEs / editores -----
.vscode/                  
.idea/                      
*.sublime-project
*.sublime-workspace
*.code-workspace

# ----- Sistema operacional -----
.DS_Store                   
Thumbs.db                  
Desktop.ini                 

# ----- Logs e relatórios -----
logs/
*.log
*.log.*
pids/
*.pid

# ----- Artefatos de teste / cobertura -----
coverage/
*.tsbuildinfo
.mocha.json
.nyc_output/
.agents/
.cloude/
.turbo/
.antigravity/
.agent/
.claude/

# ----- System & editor artefacts -----
.DS_Store
Thumbs.db
Desktop.ini

# Build artefacts
.dist/
.build/
.next/
.out/
.cache/
.tmp/

# Lockfiles
package-lock.json
yarn.lock
pnpm-lock.yaml

# Config files
.npmrc
.yarnrc
.yarnrc.yml

# ----- Test files & tool caches -----
*.test.js
*.spec.js
__snapshots__/
.eslintcache
.stylelintcache

# ----- Browser debug files -----
*.map
*.css.map

# ----- Deploy folders -----
out/
static/
public/

# ----- Editor temporary files -----
*~
.#*
*.swp

# ----- Backup files -----
*.bak
*.backup
node_modules
